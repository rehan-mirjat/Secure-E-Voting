rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && ('platformAdmin' in request.auth.token)
        && request.auth.token.platformAdmin == true;
    }

    function isOrgMember(orgId) {
      return firestore.exists(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.status == 'active' &&
             firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.organizationId == orgId &&
             firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.userId == request.auth.uid;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && (
        firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.role == 'owner' ||
        firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.role == 'admin'
      );
    }

    function isOrgOwner(orgId) {
      return isOrgMember(orgId) &&
        firestore.get(/databases/(default)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.role == 'owner';
    }

    // Exact filename photo.jpg for candidate photo uploads
    match /organizations/{orgId}/events/{eventId}/candidates/{candidateId}/photo.jpg {

      // Read: Active org members can read candidate photos for ACTIVE or CLOSED events.
      // Org Admins can read candidate photos for all events in their org.
      // Super Admins can read all photos.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isOrgAdmin(orgId) ||
        (
          isOrgMember(orgId) &&
          firestore.exists(/databases/(default)/documents/votingEvents/$(eventId)) &&
          firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data.status in ["ACTIVE", "CLOSED"]
        )
      );

      // Create/Update: Active Org Owner or Admin in orgId ONLY when event status is DRAFT
      // AND candidate belongs to orgId and eventId, and event belongs to orgId.
      allow create, update: if isSignedIn()
        && isOrgAdmin(orgId)
        && firestore.exists(/databases/(default)/documents/votingEvents/$(eventId))
        && firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data.status == "DRAFT"
        && firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data.organizationId == orgId
        && firestore.exists(/databases/(default)/documents/candidates/$(candidateId))
        && firestore.get(/databases/(default)/documents/candidates/$(candidateId)).data.organizationId == orgId
        && firestore.get(/databases/(default)/documents/candidates/$(candidateId)).data.votingEventId == eventId
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size <= 5 * 1024 * 1024; // Max 5MB raw payload

      // Delete: Same authorization as create/update but without request.resource checks
      allow delete: if isSignedIn()
        && isOrgAdmin(orgId)
        && firestore.exists(/databases/(default)/documents/votingEvents/$(eventId))
        && firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data.status == "DRAFT"
        && firestore.get(/databases/(default)/documents/votingEvents/$(eventId)).data.organizationId == orgId
        && firestore.exists(/databases/(default)/documents/candidates/$(candidateId))
        && firestore.get(/databases/(default)/documents/candidates/$(candidateId)).data.organizationId == orgId
        && firestore.get(/databases/(default)/documents/candidates/$(candidateId)).data.votingEventId == eventId;
    }

    // User Profile Avatar (Max 500KB = 512000 bytes)
    match /users/{userId}/profile/{avatarFile} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && avatarFile in ['avatar.jpg', 'avatar.png', 'avatar.webp']
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 512000;
      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Organization branding is Owner-managed per the SRS.
    match /organizations/{orgId}/logo/logo.jpg {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isOrgOwner(orgId)
        && request.resource.contentType.matches('image/jpeg')
        && request.resource.size < 512000;
      allow delete: if isSignedIn()
        && isOrgOwner(orgId);
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
