rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn()
      && request.auth.token.platformAdmin == true;
    }

    function getMembership(orgId) {
      let membershipId = orgId + '_' + request.auth.uid;
      return get(/databases/$(database)/documents/organizationMembers/$(membershipId)).data;
    }

    function isOrgMember(orgId) {
      let membershipId = orgId + '_' + request.auth.uid;
      return exists(/databases/$(database)/documents/organizationMembers/$(membershipId)) &&
      getMembership(orgId).status == 'active';
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && (
        getMembership(orgId).role == 'owner' ||
        getMembership(orgId).role == 'admin'
      );
    }

    // -------------------------------------------------------------------------
    // 1. USERS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSelf(userId) || isSuperAdmin();
      allow create: if false; // Handled exclusively via completeRegistration Cloud Function

      // Cosmetic-only fields, per SRS §6/Firestore Spec §14-15.
      // Security-sensitive fields (status, role, platformAdmin, createdAt) stay server-only.
      allow update: if isSelf(userId) && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["firstName", "lastName", "displayName", "photoUrl", "phoneNumber"])
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 2. ORGANIZATIONS
    // -------------------------------------------------------------------------
    match /organizations/{organizationId} {
      allow read: if isSignedIn() && (
        isOrgMember(organizationId) ||
        isSuperAdmin()
      );

      allow create: if false; // Cloud Function only (createOrganization)

      // OPTION A (matches Firestore Rules Spec §17/§46 exactly):
      // let the Owner update branding fields directly, nothing else.
      // Uncomment to enable a direct-write path instead of routing branding
      // edits through an updateOrganization Cloud Function.
      //
      // allow update: if isSignedIn() && (
      //   isSuperAdmin() ||
      //   (
      //     getMembership(organizationId).role == 'owner' &&
      //     isOrgMember(organizationId) &&
      //     request.resource.data.diff(resource.data).affectedKeys()
      //       .hasOnly(["name", "description", "logoUrl", "brandColors", "website"])
      //   )
      // );
      //
      // OPTION B (current choice — stricter than the doc's skeleton):
      // all org mutations, including branding, go through Cloud Functions.
      // Valid per §17 ("Owner or authorized backend logic"), but requires an
      // updateOrganization Cloud Function to exist for branding changes.
      allow update: if false;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 3. MEMBERSHIPS & INVITES
    // -------------------------------------------------------------------------
    match /organizationMembers/{membershipId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isOrgAdmin(resource.data.organizationId) ||
        isSuperAdmin()
      );
      allow write: if false; // All membership writes remain Cloud Function only
    }

    // Firestore Rules Spec §13 lists Read = "Recipient/admin" for invitations.
    // Deny-all is the safe default until recipient/admin matching is implemented;
    // swap in the commented rule once invitation docs carry a resolvable
    // recipientUid (or recipientEmail matched against a verified custom claim).
    match /organizationInvitations/{invitationId} {
      // allow read: if isSignedIn() && (
      //   resource.data.recipientUid == request.auth.uid ||
      //   isOrgAdmin(resource.data.organizationId) ||
      //   isSuperAdmin()
      // );
      allow read, write: if false; // Server-only via Cloud Functions
    }

    match /organizationInvitationKeys/{keyId} {
      allow read, write: if false; // Server-only via Cloud Functions
    }

    match /organizationInvitationTokens/{tokenId} {
      allow read, write: if false; // Server-only via Cloud Functions
    }

    // Firestore Rules Spec §13 lists Read = "Admin" for joiningCodes, but the
    // §46 skeleton denies all reads. Codes should be stored as codeHash (§28
    // of the backend doc), so exposing the doc to Admins is low-risk even if
    // it contains the hash. Deny-all kept as the safe default; uncomment to
    // grant Admin visibility into active/rotated codes.
    match /joiningCodes/{codeId} {
      // allow read: if isSignedIn() && (
      //   isOrgAdmin(resource.data.organizationId) ||
      //   isSuperAdmin()
      // );
      allow read, write: if false;
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn() && (
        isOrgMember(resource.data.organizationId) ||
        isSuperAdmin()
      );
      allow write: if false; // All department writes remain Cloud Function only
    }

    // -------------------------------------------------------------------------
    // 4. VOTING EVENTS, CANDIDATES & OPTIONS
    // -------------------------------------------------------------------------
    match /votingEvents/{eventId} {
      // NOTE: "CANCELLED" isn't in the SRS §7.2 lifecycle (Draft/Scheduled/
      // Active/Closed/Archived). Either add it to the SRS or drop it here so
      // the two docs stay in sync — left as-is functionally since isOrgAdmin
      // already sees every status regardless of this list.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isOrgMember(resource.data.organizationId) && (
            (resource.data.status in ["ACTIVE", "CLOSED"]) ||
            isOrgAdmin(resource.data.organizationId)
          )
        )
      );

      allow write: if false; // All mutations are Cloud Function only
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isOrgMember(resource.data.organizationId) && (
            (get(/databases/$(database)/documents/votingEvents/$(resource.data.votingEventId)).data.status in ["ACTIVE", "CLOSED"]) ||
            isOrgAdmin(resource.data.organizationId)
          )
        )
      );

      allow write: if false; // All candidate writes remain Cloud Function only
    }

    match /pollOptions/{optionId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isOrgMember(resource.data.organizationId) && (
            (get(/databases/$(database)/documents/votingEvents/$(resource.data.votingEventId)).data.status in ["ACTIVE", "CLOSED"]) ||
            isOrgAdmin(resource.data.organizationId)
          )
        )
      );

      allow write: if false; // All poll option writes remain Cloud Function only
    }

    // -------------------------------------------------------------------------
    // 5. VOTES & PARTICIPATION
    // -------------------------------------------------------------------------
    match /votes/{voteId} {
      // Firestore Rules Spec §32: "The Flutter application has no direct
      // access path to vote records." No exception, not even Super Admin.
      allow read, write: if false;
    }

    match /participation/{participationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if false; // All participation writes are Cloud Function only
    }

    // FIX: Firestore Rules Spec §39: "A voter may read their own receipt."
    // Previously denied to everyone, which breaks the "Vote Success /
    // Receipt" screen (SRS §28).
    match /voteReceipts/{receiptId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if false; // Server-only (generateReceipt Cloud Function)
    }

    // -------------------------------------------------------------------------
    // 6. AUDIT LOGS & REPORTS
    // -------------------------------------------------------------------------
    // FIX: Firestore Rules Spec §41: "Owner/Admin may read audit records
    // belonging to their organization where authorized." SRS §3.2/§3.3 list
    // this as a stated Owner/Admin privilege. Previously denied to everyone.
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (
        isOrgAdmin(resource.data.organizationId) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // FIX: Firestore Rules Spec §43: "Only Platform Super Admins may read
    // platform audit logs." Previously denied to everyone, including them.
    match /platformAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // No spec section defines userReports explicitly (not in the §4
    // collection list). Deny-all kept as the safe default — revisit once
    // the reporting workflow (who files, who reviews) is specified.
    match /userReports/{reportId} {
      allow read, write: if false;
    }

    // FIX: Firestore Rules Spec §44: "Platform reports shall be restricted
    // to Platform Super Admins" (i.e. readable by them). Previously denied
    // to everyone, including them.
    match /platformReports/{reportId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}